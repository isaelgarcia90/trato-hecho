# pey (https://portal.mipey.mx/developers). Sin PEY_API_KEY corre en modo simulado.
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
# PEY_BANK_ACCOUNT_ID=

# URL pública de la app (Render, Railway...), sin "/" al final
PUBLIC_URL=

# Pruebas con dinero real: la cotización muestra el precio real pero se cobra este monto
DEMO_CHARGE_AMOUNT=0.01

# Opcionales
# ALLOWED_PHONES=5512345678
# PANEL_PASSWORD=
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
PORT=3000
